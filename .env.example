# --- Upstream LLM (OpenAI-compatible: OpenAI, Groq, OpenRouter, Ollama, vLLM, etc.) ---
# Prefer these generic names:
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=

# Backward-compatible aliases (still read if UPSTREAM_* unset):
# OPENAI_BASE_URL=
# OPENAI_API_KEY=

# Another alias for the API key only:
# LLM_API_KEY=

# Examples (base may end in /v1 — ShieldAI avoids duplicate /v1/v1 in the upstream URL):
# Groq:  UPSTREAM_BASE_URL=https://api.groq.com/openai/v1  UPSTREAM_API_KEY=gsk_...
# Ollama: UPSTREAM_BASE_URL=http://127.0.0.1:11434/v1     UPSTREAM_API_KEY=ollama

SHIELD_INTERNAL_TOKEN=dev-internal

# Client allowlist for the proxy. Comma-separated keys accepted via the
# X-ShieldAI-Key header on /v1/chat/completions. Leave EMPTY to keep the proxy
# open (anonymous) for local demos; set it to lock the gateway down in prod.
SHIELD_API_KEYS=
DASHBOARD_ORIGINS=http://localhost:5173
VAULT_TTL_SECONDS=900
INJECTION_POLICY=block
AUDIT_SQLITE_PATH=./data/shieldai_audit.db
CONFIG_STORE_PATH=./data/shieldai_config.json
SHADOW_MODE=false

# PII detection backend. Primary is 'transformers' (Hugging Face, 100% recall,
# ~42ms) which needs:  pip install -e ".[transformers]"
# If those packages are absent it auto-falls back to 'spacy' (fast, ~6ms).
# Set NLP_ENGINE=spacy to force the lightweight engine.
NLP_ENGINE=transformers
TRANSFORMERS_MODEL=dslim/bert-base-NER

# Browser demo chat at http://127.0.0.1:8888/chat (set false on public servers)
DEMO_CHAT_ENABLED=true
DEMO_CHAT_DEFAULT_MODEL=openai/gpt-oss-120b
DASHBOARD_ENABLED=true
# Original prompt snapshots are sensitive. Keep disabled unless actively debugging.
PROMPT_DEBUG_ENABLED=false

# Optional: comma-separated origins for other local web chat UIs (CORS), e.g. http://localhost:3000
EXTRA_CORS_ORIGINS=

# --- Zero-Trust identity & access (PPAG) ---
# When true, every /v1/chat/completions request must carry a valid Bearer JWT
# from POST /v1/auth/token, RBAC role is enforced, and compliance policy
# block/hold actions are applied. Leave false for the open demo.
ZERO_TRUST_ENABLED=false
JWT_SECRET=dev-jwt-secret-change-me
JWT_ISSUER=shieldai-ppag
JWT_TTL_SECONDS=3600
USERS_STORE_PATH=./data/shieldai_users.json
# Require a TOTP code at login for users that have MFA enrolled.
MFA_ENABLED=false

# --- Compliance & governance ---
POLICY_STORE_PATH=./data/shieldai_policies.json
APPROVALS_STORE_PATH=./data/shieldai_approvals.json
METRICS_STORE_PATH=./data/shieldai_metrics.json
# Semantic risk tier at/above which a prompt is held for human approval.
APPROVAL_REQUIRED_TIER=critical
# When true (+ Zero-Trust), high/critical prompts from a device that does not
# send "X-Device-Trusted: true" are held for approval.
REQUIRE_TRUSTED_DEVICE=false

# --- SIEM integration ---
# Optional HTTP collector URL; /internal/siem/export?forward=true POSTs CEF events.
SIEM_WEBHOOK_URL=

# --- Privacy: AES-256-GCM vault encryption at rest ---
# Base64 32-byte key. Generate one:
#   python -c "from app.core.encryption import generate_key_b64 as g; print(g())"
# Empty == in-memory plaintext (still TTL-bounded). Requires 'cryptography'.
VAULT_ENCRYPTION_KEY=
